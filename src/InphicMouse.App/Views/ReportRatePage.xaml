<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InphicMouse.App.Views.ReportRatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="回报率" Style="{StaticResource TitleTextBlockStyle}"/>
            <ComboBox Header="回报率档位" ItemsSource="{x:Bind Vm.Options}"
                      SelectedIndex="{x:Bind Vm.SelectedIndex, Mode=TwoWay}" MinWidth="220"/>
            <Button Content="应用" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.ApplyCommand}"/>
            <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
