<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InphicMouse.App.Views.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="设备信息" Style="{StaticResource TitleTextBlockStyle}"/>

            <InfoBar IsOpen="{x:Bind Vm.IsSimulated, Mode=OneWay}" Severity="Informational"
                     IsClosable="False" Title="演示模式"
                     Message="未检测到鼠标，当前为演示数据。连接真实设备后点击“重新连接”。"/>

            <Grid ColumnDefinitions="140,*" RowSpacing="10" ColumnSpacing="12"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="型号" Opacity="0.7"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Vm.ModelName, Mode=OneWay}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="连接状态" Opacity="0.7"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Vm.ConnectionText, Mode=OneWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="连接模式" Opacity="0.7"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Vm.ModeText, Mode=OneWay}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="电量" Opacity="0.7"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Vm.BatteryText, Mode=OneWay}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="固件版本" Opacity="0.7"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind Vm.FirmwareText, Mode=OneWay}"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="传感器 IC" Opacity="0.7"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind Vm.IcText, Mode=OneWay}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="刷新信息" Command="{x:Bind Vm.RefreshCommand}"/>
                <Button Content="重新连接" Command="{x:Bind Vm.ReconnectCommand}"/>
            </StackPanel>
            <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Opacity="0.7"/>

            <TextBlock Text="实机诊断" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="「导出诊断」会逐条读取 0x10~0x20 并打印原始字节 + 解码结果，同时保存到程序目录的 txt；可直接复制发给开发者校准协议。灯光校准：在官方软件切换某灯效后点「读当前灯光id」。"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="导出诊断" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.ExportDiagnosticsCommand}"/>
                <Button Content="复制诊断" Command="{x:Bind Vm.CopyDiagnosticsCommand}"/>
                <Button Content="读当前灯光id" Command="{x:Bind Vm.ReadLightIdCommand}"/>
                <Button Content="读宏1内容" Command="{x:Bind Vm.ReadMacroCommand}"/>
            </StackPanel>
            <TextBox Text="{x:Bind Vm.Diagnostics, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="320"
                     FontFamily="Consolas" IsSpellCheckEnabled="False"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</Page>
