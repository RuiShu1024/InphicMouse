<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InphicMouse.App.Views.LightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="灯光" Style="{StaticResource TitleTextBlockStyle}"/>

            <ComboBox Header="灯光模式" ItemsSource="{x:Bind Vm.Modes}"
                      SelectedIndex="{x:Bind Vm.SelectedIndex, Mode=TwoWay}" MinWidth="220"/>

            <StackPanel Spacing="4" Visibility="{x:Bind Vm.BrightnessVisibility, Mode=OneWay}">
                <TextBlock Text="亮度"/>
                <Slider Minimum="1" Maximum="4" Value="{x:Bind Vm.Brightness, Mode=TwoWay}"
                        StepFrequency="1" SnapsTo="Ticks" TickFrequency="1" TickPlacement="Outside"/>
                <Grid>
                    <TextBlock Text="暗" HorizontalAlignment="Left" Opacity="0.6" FontSize="12"/>
                    <TextBlock Text="亮" HorizontalAlignment="Right" Opacity="0.6" FontSize="12"/>
                </Grid>
            </StackPanel>
            <StackPanel Spacing="4" Visibility="{x:Bind Vm.SpeedVisibility, Mode=OneWay}">
                <TextBlock Text="速度"/>
                <Slider Minimum="1" Maximum="4" Value="{x:Bind Vm.Speed, Mode=TwoWay}"
                        StepFrequency="1" SnapsTo="Ticks" TickFrequency="1" TickPlacement="Outside"/>
                <Grid>
                    <TextBlock Text="慢" HorizontalAlignment="Left" Opacity="0.6" FontSize="12"/>
                    <TextBlock Text="快" HorizontalAlignment="Right" Opacity="0.6" FontSize="12"/>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind Vm.ColorVisibility, Mode=OneWay}">
                <TextBlock Text="颜色（常亮/单色模式使用）"/>
                <Button Padding="6" HorizontalAlignment="Left" ToolTipService.ToolTip="{x:Bind Vm.ColorHex, Mode=OneWay}">
                    <Border Width="64" Height="24" CornerRadius="3"
                            Background="{x:Bind Vm.ColorBrush, Mode=OneWay}"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <Button.Flyout>
                        <Flyout>
                            <ColorPicker Color="{x:Bind Vm.PickerColor, Mode=TwoWay}"
                                         ColorSpectrumShape="Ring" IsAlphaEnabled="False"
                                         IsHexInputVisible="True" IsColorChannelTextInputVisible="True"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="应用" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.ApplyCommand}"/>
                <Button Content="恢复默认" Command="{x:Bind Vm.ResetCommand}"/>
            </StackPanel>
            <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
