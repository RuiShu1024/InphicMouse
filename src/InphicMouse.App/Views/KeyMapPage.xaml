<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InphicMouse.App.Views.KeyMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InphicMouse.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="鼠标按键" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="为每个物理按键指定功能：鼠标功能 / DPI / 多媒体 / 宏 / 关闭按键，或选择「键盘快捷键」后在输入框内按下组合键捕获（如 Ctrl+C）。宏的内容在「快捷指令」页编辑并上传。"/>

            <ItemsControl ItemsSource="{x:Bind Vm.Keys}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyEditItem">
                        <Grid ColumnDefinitions="88,160,*" ColumnSpacing="12" Margin="0,6" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{x:Bind KeyName}" VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind Categories}"
                                      SelectedIndex="{x:Bind CategoryIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                            <!-- 固定功能：选项下拉 -->
                            <ComboBox Grid.Column="2" ItemsSource="{x:Bind Options}"
                                      SelectedIndex="{x:Bind OptionIndex, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Visibility="{x:Bind OptionsVisibility, Mode=OneWay}"/>

                            <!-- 键盘快捷键：捕获框 -->
                            <TextBox Grid.Column="2" IsReadOnly="True"
                                     Text="{x:Bind CapturedText, Mode=OneWay}"
                                     PlaceholderText="点此后按下组合键"
                                     PreviewKeyDown="Capture_PreviewKeyDown"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Visibility="{x:Bind CaptureVisibility, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="应用" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click"/>
                <Button Content="恢复默认键位" Command="{x:Bind Vm.ResetDefaultCommand}"/>
            </StackPanel>
            <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Opacity="0.7"/>
        </StackPanel>
    </ScrollViewer>
</Page>
